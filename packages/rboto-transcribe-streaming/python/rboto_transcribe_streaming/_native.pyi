@final
class GetMedicalScribeStreamOutput:
    @property
    def medical_scribe_stream_details(self) -> MedicalScribeStreamDetails | None: ...
    def to_dict(self) -> dict[str, object]: ...



@final
class TranscribeStreamingClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
        config: ClientConfig | None = None,
    ) -> None: ...

    def get_medical_scribe_stream(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetMedicalScribeStreamOutput]: ...

    def start_call_analytics_stream_transcription(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[StartCallAnalyticsStreamTranscriptionOutput]: ...

    def start_medical_scribe_stream(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[StartMedicalScribeStreamOutput]: ...

    def start_medical_stream_transcription(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[StartMedicalStreamTranscriptionOutput]: ...

    def start_stream_transcription(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[StartStreamTranscriptionOutput]: ...
