from __future__ import annotations

from collections.abc import AsyncIterator
from typing import final


@final
class ByteStream:
    def __aiter__(self) -> AsyncIterator[bytes]: ...
    async def __anext__(self) -> bytes: ...
    async def read(self) -> bytes: ...



@final
class BatchResultErrorEntry:
    @property
    def id(self) -> str: ...
    @property
    def sender_fault(self) -> bool: ...
    @property
    def code(self) -> str: ...
    @property
    def message(self) -> str | None: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class ChangeMessageVisibilityBatchResultEntry:
    @property
    def id(self) -> str: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class DeleteMessageBatchResultEntry:
    @property
    def id(self) -> str: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class ListMessageMoveTasksResultEntry:
    @property
    def task_handle(self) -> str | None: ...
    @property
    def status(self) -> str | None: ...
    @property
    def source_arn(self) -> str | None: ...
    @property
    def destination_arn(self) -> str | None: ...
    @property
    def max_number_of_messages_per_second(self) -> int | None: ...
    @property
    def approximate_number_of_messages_moved(self) -> int: ...
    @property
    def approximate_number_of_messages_to_move(self) -> int | None: ...
    @property
    def failure_reason(self) -> str | None: ...
    @property
    def started_timestamp(self) -> int: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class Message:
    @property
    def message_id(self) -> str | None: ...
    @property
    def receipt_handle(self) -> str | None: ...
    @property
    def md5_of_body(self) -> str | None: ...
    @property
    def body(self) -> str | None: ...
    @property
    def attributes(self) -> dict[str, str] | None: ...
    @property
    def md5_of_message_attributes(self) -> str | None: ...
    @property
    def message_attributes(self) -> dict[str, MessageAttributeValue] | None: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class MessageAttributeValue:
    @property
    def string_value(self) -> str | None: ...
    @property
    def binary_value(self) -> bytes | None: ...
    @property
    def string_list_values(self) -> list[str] | None: ...
    @property
    def binary_list_values(self) -> list[bytes] | None: ...
    @property
    def data_type(self) -> str: ...
    def to_dict(self) -> dict[str, object]: ...

