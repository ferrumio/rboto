@final
class SignInClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
    ) -> None: ...

    def create_o_auth2_token(self, params: dict[str, object]) -> Awaitable[CreateOAuth2TokenResponse]: ...

    def create_o_auth2_token_with_iam(self, params: dict[str, object]) -> Awaitable[CreateOAuth2TokenWithIAMResponse]: ...

    def delete_console_authorization_configuration(self, params: dict[str, object]) -> Awaitable[DeleteConsoleAuthorizationConfigurationOutput]: ...

    def delete_resource_permission_statement(self, params: dict[str, object]) -> Awaitable[DeleteResourcePermissionStatementOutput]: ...

    def get_console_authorization_configuration(self, params: dict[str, object]) -> Awaitable[GetConsoleAuthorizationConfigurationOutput]: ...

    def get_resource_policy(self, params: dict[str, object]) -> Awaitable[GetResourcePolicyOutput]: ...

    def introspect_o_auth2_token_with_iam(self, params: dict[str, object]) -> Awaitable[IntrospectOAuth2TokenWithIAMResponse]: ...

    def list_resource_permission_statements(self, params: dict[str, object]) -> Awaitable[ListResourcePermissionStatementsOutput]: ...

    def put_console_authorization_configuration(self, params: dict[str, object]) -> Awaitable[PutConsoleAuthorizationConfigurationOutput]: ...

    def put_resource_permission_statement(self, params: dict[str, object]) -> Awaitable[PutResourcePermissionStatementOutput]: ...

    def revoke_o_auth2_token_with_iam(self, params: dict[str, object]) -> Awaitable[RevokeOAuth2TokenWithIAMResponse]: ...
