    @property
    def task_status(self) -> _types.TaskStatusOutput | None: ...
    @property
    def task_status_reason(self) -> str | None: ...
    @property
    def output_uri(self) -> str | None: ...
    @property
    def creation_time(self) -> str | None: ...
    @property
    def request_characters(self) -> int: ...
    @property
