class PutLexiconOutput:
    def to_dict(self) -> dict[str, object]: ...

@final
class StartSpeechSynthesisTaskOutput:
    @property
    def synthesis_task(self) -> SynthesisTask | None: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class SynthesizeSpeechOutput:
    @property
    def audio_stream(self) -> ByteStream: ...
    @property
    def content_type(self) -> str | None: ...
    @property
    def request_characters(self) -> int: ...
    def to_dict(self) -> dict[str, object]: ...



@final
class PollyClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
        config: ClientConfig | None = None,
    ) -> None: ...

    def delete_lexicon(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DeleteLexiconOutput]: ...

    def describe_voices(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DescribeVoicesOutput]: ...

    def get_lexicon(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetLexiconOutput]: ...

    def get_speech_synthesis_task(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetSpeechSynthesisTaskOutput]: ...

    def list_lexicons(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListLexiconsOutput]: ...

    def list_speech_synthesis_tasks(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListSpeechSynthesisTasksOutput]: ...

    def put_lexicon(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[PutLexiconOutput]: ...

    def start_speech_synthesis_stream(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[StartSpeechSynthesisStreamOutput]: ...

    def start_speech_synthesis_task(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[StartSpeechSynthesisTaskOutput]: ...

    def synthesize_speech(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[SynthesizeSpeechOutput]: ...
