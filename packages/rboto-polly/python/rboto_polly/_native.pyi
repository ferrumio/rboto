@final
class DeleteLexiconOutput:
    def to_dict(self) -> dict[str, object]: ...

@final
class DescribeVoicesOutput:
    @property
    def voices(self) -> list[Voice] | None: ...
    @property
    def next_token(self) -> str | None: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class GetLexiconOutput:
    @property
