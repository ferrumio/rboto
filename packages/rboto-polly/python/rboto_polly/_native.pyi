    @property
    def lexicon_names(self) -> list[str] | None: ...
    @property
    def output_format(self) -> _types.OutputFormatOutput | None: ...
    @property
    def sample_rate(self) -> str | None: ...
    @property
    def speech_mark_types(self) -> list[_types.SpeechMarkTypeOutput] | None: ...
    @property
