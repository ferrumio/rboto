@final
class Voice:
    @property
    def gender(self) -> _types.GenderOutput | None: ...
    @property
    def id(self) -> _types.VoiceIdOutput | None: ...
    @property
    def language_code(self) -> _types.LanguageCodeOutput | None: ...
    @property
