@final
class LexRuntimeV2Client:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
        config: ClientConfig | None = None,
    ) -> None: ...

    def delete_session(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DeleteSessionOutput]: ...

    def get_session(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetSessionOutput]: ...

    def put_session(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[PutSessionOutput]: ...

    def recognize_text(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[RecognizeTextOutput]: ...

    def recognize_utterance(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[RecognizeUtteranceOutput]: ...

    def start_conversation(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[StartConversationOutput]: ...
