from __future__ import annotations

from collections.abc import AsyncIterator, Awaitable
from typing import final
from rboto.config import ClientConfig
from . import types as _types
from .types import JSONValue

from .types import StartSpeechSynthesisStreamOutput


@final
class ByteStream:
    def __aiter__(self) -> AsyncIterator[bytes]: ...
    def __anext__(self) -> Awaitable[bytes]: ...
    def read(self) -> Awaitable[bytes]: ...

@final
class StartSpeechSynthesisStreamEventStreamReceiver:
    def __aiter__(self) -> AsyncIterator[_types.StartSpeechSynthesisStreamEventStream]: ...
    def __anext__(self) -> Awaitable[_types.StartSpeechSynthesisStreamEventStream]: ...


@final
class Lexicon:
    @property
    def content(self) -> str | None: ...
    @property
    def name(self) -> str | None: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class LexiconAttributes:
    @property
    def alphabet(self) -> str | None: ...
    @property
    def language_code(self) -> _types.LanguageCodeOutput | None: ...
    @property
    def last_modified(self) -> str | None: ...
    @property
    def lexicon_arn(self) -> str | None: ...
    @property
    def lexemes_count(self) -> int: ...
    @property
    def size(self) -> int: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class LexiconDescription:
    @property
    def name(self) -> str | None: ...
    @property
    def attributes(self) -> LexiconAttributes | None: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class SynthesisTask:
    @property
    def engine(self) -> _types.EngineOutput | None: ...
    @property
