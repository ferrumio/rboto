@final
class STSClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
        config: ClientConfig | None = None,
    ) -> None: ...

    def assume_role(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[AssumeRoleResponse]: ...

    def assume_role_with_saml(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[AssumeRoleWithSAMLResponse]: ...

    def assume_role_with_web_identity(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[AssumeRoleWithWebIdentityResponse]: ...

    def assume_root(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[AssumeRootResponse]: ...

    def decode_authorization_message(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DecodeAuthorizationMessageResponse]: ...

    def get_access_key_info(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetAccessKeyInfoResponse]: ...

    def get_caller_identity(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetCallerIdentityResponse]: ...

    def get_delegated_access_token(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetDelegatedAccessTokenResponse]: ...

    def get_federation_token(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetFederationTokenResponse]: ...

    def get_session_token(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetSessionTokenResponse]: ...

    def get_web_identity_token(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetWebIdentityTokenResponse]: ...
