[build-system]
requires = ["maturin>=1.15,<2.0"]
build-backend = "maturin"

[project]
name = "{{ distribution_name }}"
version = "{{ version }}"
description = "rboto: async-only, typed Python client for {{ public_name }}, powered by Rust. Alpha preview."
readme = "README.md"
requires-python = ">=3.12"
license = "Apache-2.0"
license-files = ["LICENSE"]
authors = [
    { name = "Leandro Cavalcante Damascena", email = "leandro.damascena@gmail.com" },
]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "Framework :: AsyncIO",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.12",
    "Programming Language :: Python :: 3.13",
    "Programming Language :: Python :: 3.14",
    "Programming Language :: Python :: 3.15",
    "Programming Language :: Rust",
    "Topic :: Software Development :: Libraries :: Python Modules",
    "Typing :: Typed",
]
keywords = ["rboto", "aws", "{{ service_id }}", "asyncio", "typing", "rust"]
dependencies = ["rboto=={{ version }}"]

[project.urls]
Documentation = "https://ferrumio.github.io/rboto/{{ documentation_path }}"
Repository = "https://github.com/ferrumio/rboto"
Homepage = "https://ferrumio.github.io/rboto/"
Issues = "https://github.com/ferrumio/rboto/issues"
Changelog = "https://github.com/ferrumio/rboto/releases"

[tool.maturin]
manifest-path = "../../crates/{{ distribution_name }}/Cargo.toml"
python-source = "python"
module-name = "{{ python_package }}._native"
features = ["pyo3/extension-module"]
