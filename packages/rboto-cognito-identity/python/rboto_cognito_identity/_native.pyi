@final
class CognitoIdentityClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
        config: ClientConfig | None = None,
    ) -> None: ...

    def create_identity_pool(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[CreateIdentityPoolOutput]: ...

    def delete_identities(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DeleteIdentitiesResponse]: ...

    def delete_identity_pool(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def describe_identity(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DescribeIdentityOutput]: ...

    def describe_identity_pool(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DescribeIdentityPoolOutput]: ...

    def get_credentials_for_identity(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetCredentialsForIdentityResponse]: ...

    def get_id(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetIdResponse]: ...

    def get_identity_pool_roles(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetIdentityPoolRolesResponse]: ...

    def get_open_id_token(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetOpenIdTokenResponse]: ...

    def get_open_id_token_for_developer_identity(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetOpenIdTokenForDeveloperIdentityResponse]: ...

    def get_principal_tag_attribute_map(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetPrincipalTagAttributeMapResponse]: ...

    def list_identities(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListIdentitiesResponse]: ...

    def list_identity_pools(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListIdentityPoolsResponse]: ...

    def list_tags_for_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListTagsForResourceResponse]: ...

    def lookup_developer_identity(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[LookupDeveloperIdentityResponse]: ...

    def merge_developer_identities(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[MergeDeveloperIdentitiesResponse]: ...

    def set_identity_pool_roles(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def set_principal_tag_attribute_map(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[SetPrincipalTagAttributeMapResponse]: ...

    def tag_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[TagResourceResponse]: ...

    def unlink_developer_identity(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def unlink_identity(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def untag_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[UntagResourceResponse]: ...

    def update_identity_pool(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[UpdateIdentityPoolOutput]: ...
