@final
class SQSClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
    ) -> None: ...

    async def add_permission(self, params: dict[str, object]) -> None: ...

    async def cancel_message_move_task(self, params: dict[str, object]) -> CancelMessageMoveTaskResult: ...

    async def change_message_visibility(self, params: dict[str, object]) -> None: ...

    async def change_message_visibility_batch(self, params: dict[str, object]) -> ChangeMessageVisibilityBatchResult: ...

    async def create_queue(self, params: dict[str, object]) -> CreateQueueResult: ...

    async def delete_message(self, params: dict[str, object]) -> None: ...

    async def delete_message_batch(self, params: dict[str, object]) -> DeleteMessageBatchResult: ...

    async def delete_queue(self, params: dict[str, object]) -> None: ...

    async def get_queue_attributes(self, params: dict[str, object]) -> GetQueueAttributesResult: ...

    async def get_queue_url(self, params: dict[str, object]) -> GetQueueUrlResult: ...

    async def list_dead_letter_source_queues(self, params: dict[str, object]) -> ListDeadLetterSourceQueuesResult: ...

    async def list_message_move_tasks(self, params: dict[str, object]) -> ListMessageMoveTasksResult: ...

    async def list_queues(self, params: dict[str, object]) -> ListQueuesResult: ...

    async def list_queue_tags(self, params: dict[str, object]) -> ListQueueTagsResult: ...

    async def purge_queue(self, params: dict[str, object]) -> None: ...

    async def receive_message(self, params: dict[str, object]) -> ReceiveMessageResult: ...

    async def remove_permission(self, params: dict[str, object]) -> None: ...

    async def send_message(self, params: dict[str, object]) -> SendMessageResult: ...

    async def send_message_batch(self, params: dict[str, object]) -> SendMessageBatchResult: ...

    async def set_queue_attributes(self, params: dict[str, object]) -> None: ...

    async def start_message_move_task(self, params: dict[str, object]) -> StartMessageMoveTaskResult: ...

    async def tag_queue(self, params: dict[str, object]) -> None: ...

    async def untag_queue(self, params: dict[str, object]) -> None: ...

