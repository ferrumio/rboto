@final
class SecretsManagerClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
        config: ClientConfig | None = None,
    ) -> None: ...

    def batch_get_secret_value(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[BatchGetSecretValueOutput]: ...

    def cancel_rotate_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[CancelRotateSecretOutput]: ...

    def create_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[CreateSecretOutput]: ...

    def delete_resource_policy(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DeleteResourcePolicyOutput]: ...

    def delete_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DeleteSecretOutput]: ...

    def describe_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DescribeSecretOutput]: ...

    def get_random_password(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetRandomPasswordOutput]: ...

    def get_resource_policy(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetResourcePolicyOutput]: ...

    def get_secret_value(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetSecretValueOutput]: ...

    def list_secret_version_ids(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListSecretVersionIdsOutput]: ...

    def list_secrets(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListSecretsOutput]: ...

    def put_resource_policy(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[PutResourcePolicyOutput]: ...

    def put_secret_value(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[PutSecretValueOutput]: ...

    def remove_regions_from_replication(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[RemoveRegionsFromReplicationOutput]: ...

    def replicate_secret_to_regions(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ReplicateSecretToRegionsOutput]: ...

    def restore_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[RestoreSecretOutput]: ...

    def rotate_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[RotateSecretOutput]: ...

    def stop_replication_to_replica(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[StopReplicationToReplicaOutput]: ...

    def tag_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def untag_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def update_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[UpdateSecretOutput]: ...

    def update_secret_version_stage(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[UpdateSecretVersionStageOutput]: ...

    def validate_resource_policy(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ValidateResourcePolicyOutput]: ...
