from __future__ import annotations

from collections.abc import AsyncIterator, Awaitable
from typing import final
from . import types as _types
from .types import JSONValue


@final
class ByteStream:
    def __aiter__(self) -> AsyncIterator[bytes]: ...
    def __anext__(self) -> Awaitable[bytes]: ...
    def read(self) -> Awaitable[bytes]: ...



@final
class OutputConfiguration:
    @property
    def s3_uri(self) -> str: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class OutputSegment:
    @property
    def custom_output_status(self) -> str | None: ...
    @property
    def custom_output(self) -> str | None: ...
    @property
    def standard_output(self) -> str | None: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class Tag:
    @property
    def key(self) -> str: ...
    @property
    def value(self) -> str: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class GetDataAutomationStatusResponse:
    @property
    def status(self) -> str | None: ...
    @property
    def error_type(self) -> str | None: ...
    @property
    def error_message(self) -> str | None: ...
    @property
    def output_configuration(self) -> OutputConfiguration | None: ...
    @property
    def job_submission_time(self) -> str | None: ...
    @property
    def job_completion_time(self) -> str | None: ...
    @property
    def job_duration_in_seconds(self) -> int | None: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class InvokeDataAutomationResponse:
    @property
    def output_configuration(self) -> OutputConfiguration | None: ...
    @property
    def semantic_modality(self) -> str: ...
    @property
    def output_segments(self) -> list[OutputSegment]: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class InvokeDataAutomationAsyncResponse:
    @property
    def invocation_arn(self) -> str: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class ListTagsForResourceResponse:
    @property
    def tags(self) -> list[Tag] | None: ...
    def to_dict(self) -> dict[str, object]: ...

@final
class TagResourceResponse:
    def to_dict(self) -> dict[str, object]: ...

@final
class UntagResourceResponse:
    def to_dict(self) -> dict[str, object]: ...



@final
class BedrockDataAutomationRuntimeClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
    ) -> None: ...

    def get_data_automation_status(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetDataAutomationStatusResponse]: ...

    def invoke_data_automation(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[InvokeDataAutomationResponse]: ...

    def invoke_data_automation_async(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[InvokeDataAutomationAsyncResponse]: ...

    def list_tags_for_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListTagsForResourceResponse]: ...

    def tag_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[TagResourceResponse]: ...

    def untag_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[UntagResourceResponse]: ...
