@final
class BedrockDataAutomationRuntimeClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
        config: ClientConfig | None = None,
    ) -> None: ...
    def _ensure_open(self) -> None: ...
    def aclose(self) -> Awaitable[None]: ...
    def __aenter__(self) -> Awaitable[BedrockDataAutomationRuntimeClient]: ...
    def __aexit__(self, exc_type: type[BaseException] | None, exc: BaseException | None, traceback: _TracebackType | None) -> Awaitable[None]: ...

    def get_data_automation_status(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetDataAutomationStatusOutput]: ...

    def invoke_data_automation(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[InvokeDataAutomationOutput]: ...

    def invoke_data_automation_async(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[InvokeDataAutomationAsyncOutput]: ...

    def list_tags_for_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListTagsForResourceOutput]: ...

    def tag_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[TagResourceOutput]: ...

    def untag_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[UntagResourceOutput]: ...
