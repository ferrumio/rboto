@final
class ConnectHealthClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
    ) -> None: ...

    def activate_subscription(self, params: dict[str, object]) -> Awaitable[ActivateSubscriptionOutput]: ...

    def create_domain(self, params: dict[str, object]) -> Awaitable[CreateDomainOutput]: ...

    def create_subscription(self, params: dict[str, object]) -> Awaitable[CreateSubscriptionOutput]: ...

    def deactivate_subscription(self, params: dict[str, object]) -> Awaitable[DeactivateSubscriptionOutput]: ...

    def delete_domain(self, params: dict[str, object]) -> Awaitable[DeleteDomainOutput]: ...

    def get_domain(self, params: dict[str, object]) -> Awaitable[GetDomainOutput]: ...

    def get_medical_scribe_listening_session(self, params: dict[str, object]) -> Awaitable[GetMedicalScribeListeningSessionOutput]: ...

    def get_patient_insights_job(self, params: dict[str, object]) -> Awaitable[GetPatientInsightsJobResponse]: ...

    def get_subscription(self, params: dict[str, object]) -> Awaitable[GetSubscriptionOutput]: ...

    def list_domains(self, params: dict[str, object]) -> Awaitable[ListDomainsOutput]: ...

    def list_subscriptions(self, params: dict[str, object]) -> Awaitable[ListSubscriptionsOutput]: ...

    def list_tags_for_resource(self, params: dict[str, object]) -> Awaitable[ListTagsForResourceOutput]: ...

    def start_medical_scribe_listening_session(self, params: dict[str, object]) -> Awaitable[StartMedicalScribeListeningSessionOutput]: ...

    def start_patient_insights_job(self, params: dict[str, object]) -> Awaitable[StartPatientInsightsJobResponse]: ...

    def tag_resource(self, params: dict[str, object]) -> Awaitable[None]: ...

    def untag_resource(self, params: dict[str, object]) -> Awaitable[None]: ...
