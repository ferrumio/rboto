@final
class SchedulerClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
        config: ClientConfig | None = None,
    ) -> None: ...

    def create_schedule(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[CreateScheduleOutput]: ...

    def create_schedule_group(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[CreateScheduleGroupOutput]: ...

    def delete_schedule(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DeleteScheduleOutput]: ...

    def delete_schedule_group(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DeleteScheduleGroupOutput]: ...

    def get_schedule(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetScheduleOutput]: ...

    def get_schedule_group(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetScheduleGroupOutput]: ...

    def list_schedule_groups(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListScheduleGroupsOutput]: ...

    def list_schedules(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListSchedulesOutput]: ...

    def list_tags_for_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListTagsForResourceOutput]: ...

    def tag_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[TagResourceOutput]: ...

    def untag_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[UntagResourceOutput]: ...

    def update_schedule(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[UpdateScheduleOutput]: ...
