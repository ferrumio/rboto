    def apply_guardrail(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ApplyGuardrailOutput]: ...

    def converse(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ConverseOutput]: ...

