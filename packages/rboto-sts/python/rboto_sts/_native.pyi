@final
class STSClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
        config: ClientConfig | None = None,
    ) -> None: ...

    def assume_role(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[AssumeRoleOutput]: ...

    def assume_role_with_saml(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[AssumeRoleWithSAMLOutput]: ...

    def assume_role_with_web_identity(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[AssumeRoleWithWebIdentityOutput]: ...

    def assume_root(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[AssumeRootOutput]: ...

    def decode_authorization_message(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DecodeAuthorizationMessageOutput]: ...

    def get_access_key_info(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetAccessKeyInfoOutput]: ...

    def get_caller_identity(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetCallerIdentityOutput]: ...

    def get_delegated_access_token(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetDelegatedAccessTokenOutput]: ...

    def get_federation_token(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetFederationTokenOutput]: ...

    def get_session_token(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetSessionTokenOutput]: ...

    def get_web_identity_token(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetWebIdentityTokenOutput]: ...
