@final
class SQSClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
        config: ClientConfig | None = None,
    ) -> None: ...

    def add_permission(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def cancel_message_move_task(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[CancelMessageMoveTaskOutput]: ...

    def change_message_visibility(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def change_message_visibility_batch(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ChangeMessageVisibilityBatchOutput]: ...

    def create_queue(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[CreateQueueOutput]: ...

    def delete_message(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def delete_message_batch(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DeleteMessageBatchOutput]: ...

    def delete_queue(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def get_queue_attributes(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetQueueAttributesOutput]: ...

    def get_queue_url(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetQueueUrlOutput]: ...

    def list_dead_letter_source_queues(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListDeadLetterSourceQueuesOutput]: ...

    def list_message_move_tasks(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListMessageMoveTasksOutput]: ...

    def list_queue_tags(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListQueueTagsOutput]: ...

    def list_queues(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListQueuesOutput]: ...

    def purge_queue(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def receive_message(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ReceiveMessageOutput]: ...

    def remove_permission(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def send_message(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[SendMessageOutput]: ...

    def send_message_batch(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[SendMessageBatchOutput]: ...

    def set_queue_attributes(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def start_message_move_task(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[StartMessageMoveTaskOutput]: ...

    def tag_queue(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def untag_queue(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...
