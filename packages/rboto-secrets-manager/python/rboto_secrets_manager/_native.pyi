@final
class SecretsManagerClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
        config: ClientConfig | None = None,
    ) -> None: ...

    def batch_get_secret_value(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[BatchGetSecretValueResponse]: ...

    def cancel_rotate_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[CancelRotateSecretResponse]: ...

    def create_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[CreateSecretResponse]: ...

    def delete_resource_policy(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DeleteResourcePolicyResponse]: ...

    def delete_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DeleteSecretResponse]: ...

    def describe_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DescribeSecretResponse]: ...

    def get_random_password(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetRandomPasswordResponse]: ...

    def get_resource_policy(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetResourcePolicyResponse]: ...

    def get_secret_value(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetSecretValueResponse]: ...

    def list_secret_version_ids(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListSecretVersionIdsResponse]: ...

    def list_secrets(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListSecretsResponse]: ...

    def put_resource_policy(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[PutResourcePolicyResponse]: ...

    def put_secret_value(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[PutSecretValueResponse]: ...

    def remove_regions_from_replication(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[RemoveRegionsFromReplicationResponse]: ...

    def replicate_secret_to_regions(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ReplicateSecretToRegionsResponse]: ...

    def restore_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[RestoreSecretResponse]: ...

    def rotate_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[RotateSecretResponse]: ...

    def stop_replication_to_replica(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[StopReplicationToReplicaResponse]: ...

    def tag_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def untag_resource(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[None]: ...

    def update_secret(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[UpdateSecretResponse]: ...

    def update_secret_version_stage(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[UpdateSecretVersionStageResponse]: ...

    def validate_resource_policy(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ValidateResourcePolicyResponse]: ...
