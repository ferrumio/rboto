[build-system]
requires = ["maturin>=1.8,<2.0"]
build-backend = "maturin"

[project]
name = "{{ distribution_name }}"
version = "0.1.0"
description = "Async generated {{ service_id }} client for rboto, powered by the AWS SDK for Rust"
requires-python = ">=3.12"
license = { text = "Apache-2.0" }
authors = [
    { name = "Leandro Cavalcante Damascena", email = "leandro.damascena@gmail.com" },
]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "License :: OSI Approved :: Apache Software License",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.12",
    "Programming Language :: Python :: 3.13",
    "Programming Language :: Python :: 3.14",
    "Programming Language :: Rust",
    "Topic :: Software Development :: Libraries",
]
keywords = ["aws", "{{ service_id }}", "async", "rust", "python"]
dependencies = ["rboto==0.1.0"]

[project.urls]
Documentation = "https://ferrumio.github.io/rboto"
Repository = "https://github.com/ferrumio/rboto"
Homepage = "https://github.com/ferrumio/rboto"

[tool.maturin]
manifest-path = "../../crates/{{ distribution_name }}/Cargo.toml"
python-source = "python"
module-name = "{{ python_package }}._native"
features = ["pyo3/extension-module"]
