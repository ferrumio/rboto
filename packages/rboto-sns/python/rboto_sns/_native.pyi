    def get_platform_application_attributes(self, params: dict[str, object]) -> Awaitable[GetPlatformApplicationAttributesResponse]: ...

    def get_sms_attributes(self, params: dict[str, object]) -> Awaitable[GetSMSAttributesResponse]: ...

    def get_sms_sandbox_account_status(self, params: dict[str, object]) -> Awaitable[GetSMSSandboxAccountStatusResult]: ...

    def get_subscription_attributes(self, params: dict[str, object]) -> Awaitable[GetSubscriptionAttributesResponse]: ...

    def get_topic_attributes(self, params: dict[str, object]) -> Awaitable[GetTopicAttributesResponse]: ...

    def list_endpoints_by_platform_application(self, params: dict[str, object]) -> Awaitable[ListEndpointsByPlatformApplicationResponse]: ...

    def list_origination_numbers(self, params: dict[str, object]) -> Awaitable[ListOriginationNumbersResult]: ...

    def list_phone_numbers_opted_out(self, params: dict[str, object]) -> Awaitable[ListPhoneNumbersOptedOutResponse]: ...

    def list_platform_applications(self, params: dict[str, object]) -> Awaitable[ListPlatformApplicationsResponse]: ...

    def list_sms_sandbox_phone_numbers(self, params: dict[str, object]) -> Awaitable[ListSMSSandboxPhoneNumbersResult]: ...

