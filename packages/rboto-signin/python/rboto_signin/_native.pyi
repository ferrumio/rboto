@final
class SignInClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
        config: ClientConfig | None = None,
    ) -> None: ...

    def create_o_auth2_token(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[CreateOAuth2TokenOutput]: ...

    def create_o_auth2_token_with_iam(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[CreateOAuth2TokenWithIAMOutput]: ...

    def delete_console_authorization_configuration(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DeleteConsoleAuthorizationConfigurationOutput]: ...

    def delete_resource_permission_statement(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[DeleteResourcePermissionStatementOutput]: ...

    def get_console_authorization_configuration(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetConsoleAuthorizationConfigurationOutput]: ...

    def get_resource_policy(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetResourcePolicyOutput]: ...

    def introspect_o_auth2_token_with_iam(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[IntrospectOAuth2TokenWithIAMOutput]: ...

    def list_resource_permission_statements(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListResourcePermissionStatementsOutput]: ...

    def put_console_authorization_configuration(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[PutConsoleAuthorizationConfigurationOutput]: ...

    def put_resource_permission_statement(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[PutResourcePermissionStatementOutput]: ...

    def revoke_o_auth2_token_with_iam(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[RevokeOAuth2TokenWithIAMOutput]: ...
