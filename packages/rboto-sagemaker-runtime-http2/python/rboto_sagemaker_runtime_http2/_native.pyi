@final
class ByteStream:
    """See [reference](https://ferrumio.github.io/rboto/reference/sagemaker-runtime-http2/types/ByteStream/)."""
    def __aiter__(self) -> AsyncIterator[bytes]: ...
    def __anext__(self) -> Awaitable[bytes]: ...
    def read(self) -> Awaitable[bytes]: ...
    def aclose(self) -> Awaitable[None]: ...
    def __aenter__(self) -> Awaitable[ByteStream]: ...
    def __aexit__(self, exc_type: type[BaseException] | None, exc: BaseException | None, traceback: _TracebackType | None) -> Awaitable[None]: ...

@final
class ResponseStreamEventReceiver:
