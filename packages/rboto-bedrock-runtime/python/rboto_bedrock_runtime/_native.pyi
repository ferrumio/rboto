@final
class BedrockRuntimeClient:
    def __init__(
        self,
        *,
        region: str | None = None,
        profile: str | None = None,
        endpoint_url: str | None = None,
    ) -> None: ...

    def apply_guardrail(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ApplyGuardrailResponse]: ...

    def converse(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ConverseResponse]: ...

    def converse_stream(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ConverseStreamResponse]: ...

    def count_tokens(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[CountTokensResponse]: ...

    def get_async_invoke(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[GetAsyncInvokeResponse]: ...

    def invoke_guardrail_checks(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[InvokeGuardrailChecksResponse]: ...

    def invoke_model(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[InvokeModelResponse]: ...

    def invoke_model_with_bidirectional_stream(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[InvokeModelWithBidirectionalStreamResponse]: ...

    def invoke_model_with_response_stream(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[InvokeModelWithResponseStreamResponse]: ...

    def list_async_invokes(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[ListAsyncInvokesResponse]: ...

    def start_async_invoke(self, params: dict[str, object], observation: dict[str, object] | None = None) -> Awaitable[StartAsyncInvokeResponse]: ...
